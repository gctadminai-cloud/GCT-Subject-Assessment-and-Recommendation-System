# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret Configuration
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# Default Seeded Registrar Credentials (.env sourced, never hardcoded)
REGISTRAR_ADMIN_USERNAME=registrar_admin
REGISTRAR_ADMIN_PASSWORD=AdminGCT2026!
REGISTRAR_STAFF_USERNAME=registrar_staff
REGISTRAR_STAFF_PASSWORD=StaffGCT2026!

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# Google Gemini API Key (for Chatbot)
GEMINI_API_KEY=your-google-gemini-api-key

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration (Vite)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:5000/api

# Gmail SMTP Configuration (for Student Password Reset OTP)
GMAIL_USER=your-admin-email@gmail.com
GMAIL_APP_PASS=your-16-char-gmail-app-password

