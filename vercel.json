{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/students/trigger-weekly-reset-notice",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/students/trigger-weekly-reset",
      "schedule": "0 16 * * 0"
    }
  ]
}
