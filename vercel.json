{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ],
  "crons": [
    {
      "path": "/api/students/trigger-weekly-reset-notice",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/students/trigger-weekly-reset",
      "schedule": "0 16 * * 0"
    }
  ]
}
